@article{boock2026hitting,
  bibtex_show = {true},
  abbr        = {arXiv},
  title       = {Hitting Time Isomorphism for Multi-Stage Planning with Foundation Policies},
  author      = {Boock, Magnus Victor and Akg{\"u}l, Abdullah and {\c{C}}elikok, Mustafa Mert and Kandemir, Melih},
  journal     = {arXiv preprint arXiv:2605.06470},
  year        = {2026},
  abstract    = {We present a new operator-theoretic representation learning framework for offline reinforcement learning that recovers the directed temporal geometry of a controlled Markov process from hitting time observations. While prior art often produces symmetric distances or fails to satisfy the triangle inequality, our framework learns a Hilbert-space displacement geometry where expected hitting times are realized as linear functionals of latent displacements. We prove that this representation exists under latent linear closure and is uniquely identifiable up to a bounded linear isomorphism. Derived from this theory, we curate Isomorphic Embedding Learning (IEL) as a new goal-agnostic foundation policy learning algorithm, enabling robust graph-based multi-stage planning for long-horizon navigation and improving the state of the art of learning foundation policies from offline maze locomotion data.},
  url         = {https://arxiv.org/abs/2605.06470},
  eprint      = {2605.06470},
  archiveprefix = {arXiv},
  selected    = {true}
}

